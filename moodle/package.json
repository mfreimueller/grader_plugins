{
  "name": "moodle-grader-plugin",
  "version": "1.1.0",
  "private": true,
  "description": "Grader plugin: push symbol, point and grade results and notes of an assessment into a Moodle assignment.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "vue": "3.5.35"
  },
  "devDependencies": {
    "@types/node": "22.15.17",
    "@vitejs/plugin-vue": "6.0.7",
    "@vitest/coverage-v8": "5.0.4",
    "typescript": "5.9.3",
    "vite": "8.0.14",
    "vitest": "5.0.4",
    "vue-tsc": "3.3.13"
  }
}
